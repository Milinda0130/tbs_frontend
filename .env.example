# TBS Campus Frontend Environment Variables
# Copy this file to .env and fill in your values

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api

# App name
VITE_APP_NAME="TBS Campus"

# Demo mode (frontend only)
# When true, Chamath module APIs will use mock data instantly without waiting for backend timeouts.
VITE_DEMO_MODE=true
